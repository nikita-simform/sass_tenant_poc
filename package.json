{
  "name": "saas-tenant-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm run prisma:generate && npm run tenant:generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "tenant:generate": "prisma generate --config=prisma/tenant-schema/prisma.config.ts",
    "tenant:migrate:dev": "prisma migrate dev --config=prisma/tenant-schema/prisma.config.ts",
    "tenant:migrate:deploy": "prisma migrate deploy --config=prisma/tenant-schema/prisma.config.ts",
    "tenant:apply-migrations": "tsx scripts/apply-tenant-migrations.ts",
    "seed": "tsx prisma/seed.ts",
    "platform-admin:create": "tsx scripts/create-platform-admin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "jose": "^6.2.12",
    "lru-cache": "^11.5.2",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
