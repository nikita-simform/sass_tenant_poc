DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_tenant_poc?schema=public

# Used only to author/migrate the tenant-schema model (prisma/tenant-schema) —
# points at the canonical template schema. Real tenant schemas are resolved at
# runtime by src/lib/db/tenant.ts, which overrides this URL's `schema` param.
TENANT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_tenant_poc?schema=tenant_template

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
NODE_ENV=development

# Bootstrapped by prisma/seed.ts on first run
SEED_PLATFORM_ADMIN_EMAIL=admin@platform.local
SEED_PLATFORM_ADMIN_PASSWORD=change-me-please
